 "GNU计划": {
  "word": "GNU计划",
  "time": 1790751287,
  "detail": "1983年理查德·斯托曼发起的自由软件工程,目标是造一个完全自由的类Unix系统。名字是\"GNU's Not Unix\"的递归缩写。到1990年代初,Emacs、GCC等工具都齐了,唯独缺内核;1991年林纳斯补上内核,合体成GNU/Linux。斯托曼设计的GPL\"copyleft\"条款要求:代码随便用,但改出来的也得开源——这成了整个开源世界的法律地基。"
 },
 "Rust": {
  "word": "Rust",
  "time": 1790751414,
  "detail": "Rust 是 2010 年公开、2015 年发布 1.0 的系统编程语言,由 Mozilla 员工 Graydon Hoare 发起。它靠\"所有权\"规则在编译期就掐死空指针和数据竞争,不用垃圾回收也安全,速度接近 C。连年在 Stack Overflow 调查里当选\"最受喜爱语言\",如今已进入 Linux 内核和 Windows 的部分组件。"
 },
 "xz后门事件": {
  "word": "xz后门事件",
  "time": 1790751478,
  "detail": "2024年3月，微软工程师Andres Freund发现xz Utils 5.6版藏有后门：攻击者「Jia Tan」潜伏开源社区两年多，先贡献代码换取信任，再逐步塞入可在sshd中实现无密码远程登录的恶意代码，几乎混进主流Linux发行版。它暴露了开源信任链的脆弱——一个人就能威胁全球服务器。"
 },
 "代码审查": {
  "word": "代码审查",
  "time": 1790751499,
  "detail": "1976年IBM工程师Michael Fagan提出：让同事逐行读代码再开会讨论，能在测试前拦下六成以上缺陷。这套做法沿用至今，只是搬进了GitHub，变成提交Pull Request、等同事留言“这里会空指针”、改完才准合并。它既是质量关卡，也是最省钱的知识传播方式——顺带把你的烂代码公开处刑。"
 },
 "看不惯就fork": {
  "word": "看不惯就fork",
  "time": 1790751529,
  "detail": "fork 是复制别人的代码仓库另起炉灶。这句话是开源圈的处事信条：与其争论，不如复制一份自己改，GPL 等许可证保障了这一权利。2010年 LibreOffice 从 OpenOffice 分家，2011年 Hudson 改名 Jenkins，都是著名分叉。它让分歧不靠投票解决，代价是社区常被撕成两半。日常也用来劝人：不满意就自己干。"
 },
 "林纳斯骂人": {
  "word": "林纳斯骂人",
  "time": 1790751561,
  "detail": "Linux之父林纳斯·托瓦兹以在邮件列表上爆粗闻名。2012年他对着镜头向NVIDIA竖中指骂脏话,抗议其不开源显卡驱动;对内核贡献者的技术批评也常升级为人身攻击。2018年他为此道歉、暂别内核维护,社区改用新的行为准则。这既是'暴躁天才'的招牌,也逼开源圈反思:尖刻是否真等于高效。"
 },
 "云厂商白嫖": {
  "word": "云厂商白嫖",
  "time": 1790751599,
  "detail": "指开发者薅云厂商羊毛：新用户赠金、学生包、永久免费层。AWS、谷歌云、阿里云动辄送几千元试用金，Oracle的永久免费小机器成了建站神器。玩法多是挂博客、跑爬虫，挖矿基本被封。风险是忘关实例被扣费、绑卡遭盗刷。本质是云厂商烧钱抢客户的补贴战，赌你上瘾后付费。"
 },
 "Log4j漏洞": {
  "word": "Log4j漏洞",
  "time": 1790751630,
  "detail": "2021年12月，Java世界最常用的日志库 Log4j 爆出代号 Log4Shell 的漏洞：只要往任何会被写进日志的输入框塞一句特定字符串，攻击者就能让服务器下载并运行任意代码，等于直接交钥匙。它几乎无处不在，从游戏聊天框到云服务全被波及，全球工程师连夜打补丁，被称为十年一遇的漏洞。"
 }
}